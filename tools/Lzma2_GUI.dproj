<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{2F3C1C14-3C80-4381-A773-593E18B9699E}</ProjectGuid>
    <ProjectVersion>22.0</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>Lzma2_GUI.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <BDSCOMMONDIR Condition="'$(BDSCOMMONDIR)'==''">$(PUBLIC)\Documents\Embarcadero\Studio\37.0</BDSCOMMONDIR>
    <TargetedPlatforms>64</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>System;System.Win;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_DebugInformation>1</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_GenerateStackFrames>false</DCC_GenerateStackFrames>
    <DCC_RangeChecking>false</DCC_RangeChecking>
    <DCC_OverflowChecking>false</DCC_OverflowChecking>
    <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
    <DCC_Define>LZMA_MF_NATIVE_COMPACT_COLLECT;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win64)'!=''">
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
    <CfgParent>Cfg_1</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <ItemGroup>
    <RcCompile Include="Lzma2GUIManifest.rc"/>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Lzma2GUIMain.pas"/>
    <DCCReference Include="Lzma2GuiCatalog.pas"/>
    <DCCReference Include="Lzma2GuiSettings.pas"/>
    <DCCReference Include="Lzma2LanguagePicker.pas"/>
    <DCCReference Include="Lzma2GuiResources.pas"/>
    <DCCReference Include="Lzma2Benchmark.pas"/>
    <None Include="Lzma2BenchmarkBuild.inc"/>
    <None Include="Lzma2BenchmarkMethods.inc"/>
    <DCCReference Include="..\src\Lzma.Api.pas"/>
    <DCCReference Include="..\src\Lzma.Types.pas"/>
    <DCCReference Include="..\src\Lzma.Errors.pas"/>
    <DCCReference Include="..\src\Lzma.Lzma.pas"/>
    <DCCReference Include="..\src\Lzma.MatchFinder.pas"/>
    <DCCReference Include="..\src\Lzma.MtDec.pas"/>
    <DCCReference Include="..\src\Lzma.SevenZip.pas"/>
    <DCCReference Include="..\src\Lzma.Sdk.pas"/>
    <DCCReference Include="..\src\Lzma.Xz.pas"/>
    <DCCReference Include="..\src\Lzma.XzCrc.pas"/>
    <DCCReference Include="..\src\Lzma2.Encoder.pas"/>
    <DCCReference Include="..\src\Lzma2.Decoder.pas"/>
    <None Include="Lzma2_GUI.ico"/>
    <None Include="Lzma2_GUI.exe.manifest"/>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
